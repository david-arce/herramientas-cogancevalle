/* ==========================================================================
   presupuesto_tabla.css
   Estilos únicos para todas las tablas del módulo de presupuesto.
   ========================================================================== */

:root {
  --pt-borde: #dfe3e8;
  --pt-borde-fuerte: #c7ced6;
  --pt-texto: #24292f;
  --pt-texto-suave: #57606a;
  --pt-fondo: #ffffff;
  --pt-fondo-alt: #f6f8fa;
  --pt-cabecera: #eef2f6;
  --pt-azul: #0d6efd;
  --pt-verde: #198754;
  --pt-rojo: #dc3545;
  --pt-amarillo: #ffc107;
  --pt-gris: #6c757d;
  --pt-radio: 6px;
  --pt-sombra: 0 1px 3px rgba(16, 24, 40, .12);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 18px 22px 60px;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  font-size: 14px;
  color: var(--pt-texto);
  background: var(--pt-fondo-alt);
}

h2 { margin: 0 0 14px; font-size: 20px; }
h3 { margin: 0 0 6px; font-size: 15px; }

/* ---------------------------------------------------------------- Botones */
.pt-barra {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  margin-bottom: 12px;
}

.pt-barra .pt-espaciador { flex: 1 1 auto; }

.pt-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border: 1px solid var(--pt-borde-fuerte);
  border-radius: var(--pt-radio);
  background: var(--pt-fondo);
  color: var(--pt-texto);
  font-size: 13px;
  font-family: inherit;
  text-decoration: none;
  cursor: pointer;
  transition: filter .15s, background .15s;
}
.pt-btn:hover:not(:disabled) { background: var(--pt-cabecera); }
.pt-btn:disabled { opacity: .55; cursor: not-allowed; }

.pt-btn--primario  { background: var(--pt-azul);     border-color: var(--pt-azul);     color: #fff; }
.pt-btn--exito     { background: var(--pt-verde);    border-color: var(--pt-verde);    color: #fff; }
.pt-btn--peligro   { background: var(--pt-rojo);     border-color: var(--pt-rojo);     color: #fff; }
.pt-btn--aviso     { background: var(--pt-amarillo); border-color: var(--pt-amarillo); color: #3a2f00; }
.pt-btn--neutro    { background: var(--pt-gris);     border-color: var(--pt-gris);     color: #fff; }
.pt-btn--primario:hover:not(:disabled),
.pt-btn--exito:hover:not(:disabled),
.pt-btn--peligro:hover:not(:disabled),
.pt-btn--aviso:hover:not(:disabled),
.pt-btn--neutro:hover:not(:disabled) { filter: brightness(1.08); }
/* el hover genérico no debe quitar el color de los botones con variante */
.pt-btn--primario:hover:not(:disabled) { background: var(--pt-azul); }
.pt-btn--exito:hover:not(:disabled)    { background: var(--pt-verde); }
.pt-btn--peligro:hover:not(:disabled)  { background: var(--pt-rojo); }
.pt-btn--aviso:hover:not(:disabled)    { background: var(--pt-amarillo); }
.pt-btn--neutro:hover:not(:disabled)   { background: var(--pt-gris); }
.pt-btn:focus-visible { outline: 2px solid var(--pt-azul); outline-offset: 2px; }

.pt-spinner {
  width: 13px; height: 13px;
  border: 2px solid rgba(255, 255, 255, .45);
  border-top-color: #fff;
  border-radius: 50%;
  animation: pt-girar .7s linear infinite;
}
.pt-btn:not([class*="--"]) .pt-spinner {
  border-color: rgba(0, 0, 0, .2);
  border-top-color: var(--pt-texto);
}
@keyframes pt-girar { to { transform: rotate(360deg); } }

.pt-parametro {
  padding: 6px 10px;
  border: 1px dashed var(--pt-borde-fuerte);
  border-radius: var(--pt-radio);
  background: var(--pt-fondo);
  font-size: 13px;
  color: var(--pt-texto-suave);
}
.pt-parametro strong { color: var(--pt-texto); }

/* Indicador de cambios sin guardar */
.pt-pendiente {
  padding: 5px 10px;
  border-radius: 999px;
  background: #fff3cd;
  color: #7a5a00;
  font-size: 12px;
  font-weight: 600;
}
.pt-pendiente[hidden] { display: none; }

/* Franja informativa: de qué depende el concepto y a qué afecta */
.pt-aviso {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 18px;
  margin-bottom: 12px;
  padding: 8px 12px;
  border-left: 3px solid var(--pt-azul);
  border-radius: 0 var(--pt-radio) var(--pt-radio) 0;
  background: #eef5ff;
  color: var(--pt-texto-suave);
  font-size: 13px;
}
.pt-aviso strong { color: var(--pt-texto); }

/* Origen de la fila */
.pt-origen {
  display: inline-block;
  padding: 1px 7px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}
.pt-origen--sistema { background: #e7f1ff; color: #0a4fb8; }
.pt-origen--manual  { background: #fff0d9; color: #8a4b00; }

/* --------------------------------------------------------------- Paneles  */
.pt-panel {
  margin-bottom: 14px;
  padding: 12px 14px;
  background: var(--pt-fondo);
  border: 1px solid var(--pt-borde);
  border-radius: var(--pt-radio);
  box-shadow: var(--pt-sombra);
}
.pt-panel p { margin: 0 0 10px; color: var(--pt-texto-suave); font-size: 13px; }
.pt-panel__campos { display: flex; flex-wrap: wrap; gap: 10px; }
.pt-panel__campos input[type="number"] {
  width: 150px;
  padding: 6px 8px;
  border: 1px solid var(--pt-borde-fuerte);
  border-radius: var(--pt-radio);
  font-family: inherit;
  font-size: 13px;
}

/* -------------------------------------------------------------- Filtros   */
.pt-filtros {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: flex-end;
  margin-bottom: 12px;
}

.pt-filtro { display: flex; flex-direction: column; gap: 4px; }
.pt-filtro > label { font-size: 12px; font-weight: 600; color: var(--pt-texto-suave); }

.pt-multi { position: relative; width: 220px; }
.pt-multi__control {
  display: flex; align-items: center; justify-content: space-between; gap: 6px;
  width: 100%;
  min-height: 34px;
  padding: 5px 9px;
  background: var(--pt-fondo);
  border: 1px solid var(--pt-borde-fuerte);
  border-radius: var(--pt-radio);
  cursor: pointer;
  font-size: 13px;
}
.pt-multi__control:focus-visible { outline: 2px solid var(--pt-azul); outline-offset: 1px; }
.pt-multi__texto {
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  color: var(--pt-texto);
}
.pt-multi__texto--vacio { color: #8c95a0; }
.pt-multi__flecha { color: var(--pt-texto-suave); font-size: 10px; }

.pt-multi__menu {
  position: absolute; z-index: 60; top: calc(100% + 4px); left: 0; right: 0;
  background: var(--pt-fondo);
  border: 1px solid var(--pt-borde-fuerte);
  border-radius: var(--pt-radio);
  box-shadow: 0 8px 20px rgba(16, 24, 40, .16);
  display: none;
}
.pt-multi--abierto .pt-multi__menu { display: block; }

.pt-multi__buscar {
  width: 100%;
  padding: 8px 9px;
  border: 0; border-bottom: 1px solid var(--pt-borde);
  border-radius: var(--pt-radio) var(--pt-radio) 0 0;
  font-family: inherit; font-size: 13px;
}
.pt-multi__buscar:focus { outline: none; }

.pt-multi__opciones { max-height: 240px; overflow-y: auto; }
.pt-multi__opcion {
  display: flex; align-items: center; gap: 7px;
  padding: 6px 9px;
  cursor: pointer; font-size: 13px;
}
.pt-multi__opcion:hover { background: var(--pt-cabecera); }
.pt-multi__opcion input { margin: 0; }
.pt-multi__vacio { padding: 10px; color: var(--pt-texto-suave); font-size: 12px; }

.pt-multi__pie {
  display: flex; justify-content: space-between;
  padding: 6px 9px;
  border-top: 1px solid var(--pt-borde);
}
.pt-multi__pie button {
  background: none; border: 0; padding: 0;
  color: var(--pt-azul); font-size: 12px; cursor: pointer;
}

.pt-buscador { width: 260px; }
.pt-buscador input {
  width: 100%; min-height: 34px;
  padding: 6px 9px;
  border: 1px solid var(--pt-borde-fuerte);
  border-radius: var(--pt-radio);
  font-family: inherit; font-size: 13px;
}

.pt-contador { font-size: 12px; color: var(--pt-texto-suave); margin-left: auto; }

/* --------------------------------------------------------------- Tabla    */
.pt-tabla-envoltura {
  max-height: calc(100vh - 260px);
  overflow: auto;
  background: var(--pt-fondo);
  border: 1px solid var(--pt-borde);
  border-radius: var(--pt-radio);
  box-shadow: var(--pt-sombra);
}

table.pt-tabla {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 13px;
  white-space: nowrap;
}

table.pt-tabla th,
table.pt-tabla td {
  padding: 6px 10px;
  border-bottom: 1px solid var(--pt-borde);
  border-right: 1px solid var(--pt-borde);
  text-align: left;
}
table.pt-tabla th:last-child, table.pt-tabla td:last-child { border-right: 0; }

table.pt-tabla thead th {
  position: sticky; top: 0; z-index: 3;
  background: var(--pt-cabecera);
  font-weight: 600;
  user-select: none;
}
table.pt-tabla thead th.pt-ordenable { cursor: pointer; }
table.pt-tabla thead th.pt-ordenable:hover { background: #e3e9f0; }
table.pt-tabla thead th .pt-orden { margin-left: 5px; color: var(--pt-texto-suave); font-size: 10px; }

table.pt-tabla tfoot th {
  position: sticky; bottom: 0; z-index: 3;
  background: #eaf1e9;
  font-weight: 700;
  border-top: 2px solid var(--pt-borde-fuerte);
}

table.pt-tabla tbody tr:nth-child(even) { background: #fbfcfd; }
table.pt-tabla tbody tr:hover { background: #eef5ff; }
table.pt-tabla tbody tr.pt-fila--activa { background: #dcebff !important; }
table.pt-tabla tbody tr.pt-fila--marcada { background: #fff8db; }
table.pt-tabla tbody tr.pt-fila--recalcular td { color: var(--pt-texto-suave); font-style: italic; }

td.pt-num, th.pt-num, tfoot th.pt-num { text-align: right; font-variant-numeric: tabular-nums; }
td.pt-editable { cursor: cell; }
td.pt-editable:hover { box-shadow: inset 0 0 0 1px #b9d4ff; }
td.pt-col-acciones, th.pt-col-acciones,
td.pt-col-check, th.pt-col-check { text-align: center; width: 1%; }

.pt-acciones-fila { display: inline-flex; gap: 3px; }
.pt-acciones-fila button {
  border: 0; background: transparent; cursor: pointer;
  font-size: 14px; line-height: 1; padding: 2px 3px; border-radius: 4px;
}
.pt-acciones-fila button:hover { background: rgba(0, 0, 0, .08); }

.pt-entrada {
  width: 100%; min-width: 60px;
  padding: 3px 5px;
  border: 1px solid var(--pt-azul);
  border-radius: 4px;
  font: inherit;
  background: #fff;
}
select.pt-entrada { min-width: 140px; }

.pt-vacio { padding: 26px; text-align: center; color: var(--pt-texto-suave); }

@keyframes pt-destello {
  0%, 100% { background: transparent; }
  50%      { background: #fff1a8; }
}
tr.pt-destello { animation: pt-destello .6s ease-in-out 3; }

/* --------------------------------------------------------------- Toasts   */
.pt-toasts {
  position: fixed; top: 16px; right: 16px; z-index: 9999;
  display: flex; flex-direction: column; gap: 8px;
}
.pt-toast {
  min-width: 230px; max-width: 420px;
  padding: 10px 14px;
  border-radius: var(--pt-radio);
  color: #fff; font-size: 13px;
  box-shadow: 0 8px 22px rgba(16, 24, 40, .22);
  opacity: 0; transform: translateX(20px);
  transition: opacity .25s, transform .25s;
}
.pt-toast--visible { opacity: 1; transform: translateX(0); }
.pt-toast--success { background: var(--pt-verde); }
.pt-toast--error   { background: var(--pt-rojo); }
.pt-toast--info    { background: var(--pt-azul); }
.pt-toast--warning { background: var(--pt-amarillo); color: #3a2f00; }

@media (max-width: 720px) {
  body { padding: 12px; }
  .pt-multi, .pt-buscador { width: 100%; }
  .pt-filtro { width: 100%; }
}

/* ==========================================================================
   Secciones plegables (details.pt-seccion)
   ========================================================================== */
.pt-btn--enlace { background: transparent; border-color: transparent; color: var(--pt-azul); padding-left: 4px; padding-right: 4px; }
.pt-btn--enlace:hover:not(:disabled) { background: transparent; text-decoration: underline; }
.pt-btn--suave-peligro { color: var(--pt-rojo); border-color: #f1c2c7; background: #fff; }
.pt-btn--suave-peligro:hover:not(:disabled) { background: #fdf0f1; }
.pt-btn--icono { padding: 4px 8px; min-width: 32px; justify-content: center; }

.pt-seccion {
  margin: 12px 0;
  background: var(--pt-fondo);
  border: 1px solid var(--pt-borde);
  border-radius: 10px;
  box-shadow: var(--pt-sombra);
}
.pt-seccion__titulo {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 12px 16px;
  cursor: pointer; list-style: none; user-select: none;
}
.pt-seccion__titulo::-webkit-details-marker { display: none; }
.pt-seccion__titulo > span:first-child { display: flex; flex-direction: column; gap: 2px; }
.pt-seccion__titulo strong { font-size: 15px; }
.pt-seccion__titulo small { color: var(--pt-texto-suave); font-size: 12px; font-weight: 400; }
.pt-seccion__toggle {
  flex: none; font-size: 12px; color: var(--pt-azul); font-weight: 600; white-space: nowrap;
}
.pt-seccion__toggle::before { content: 'Mostrar ▾'; }
.pt-seccion[open] > .pt-seccion__titulo { border-bottom: 1px solid var(--pt-borde); }
.pt-seccion[open] > .pt-seccion__titulo .pt-seccion__toggle::before { content: 'Ocultar ▴'; }
.pt-seccion__cuerpo { padding: 14px 16px; }
.pt-seccion__cuerpo + .pt-seccion__cuerpo { border-top: 1px solid var(--pt-borde); }

/* ==========================================================================
   Panel de distribución por persona (vista consolidada)
   ========================================================================== */
.nd-grid {
  display: grid;
  grid-template-columns: minmax(240px, 1fr) minmax(420px, 2fr) minmax(200px, .8fr);
  gap: 16px;
  align-items: start;
}
@media (max-width: 1100px) { .nd-grid { grid-template-columns: 1fr; } }
.nd-bloque { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.nd-bloque--acciones .pt-btn { width: 100%; justify-content: center; }
.nd-titulo { display: flex; align-items: center; gap: 8px; margin: 0 0 4px; font-size: 13px; }
.nd-paso {
  display: inline-grid; place-items: center; width: 20px; height: 20px;
  border-radius: 50%; background: var(--pt-azul); color: #fff; font-size: 11px;
}
.nd-ayuda { margin: 0; font-size: 12px; color: var(--pt-texto-suave); line-height: 1.4; }
.nd-suave { color: var(--pt-texto-suave); font-size: 12px; }
.nd-vacio { color: #98a2ad; font-size: 12px; }
.nd-buscar { display: flex; gap: 6px; }
.nd-buscar input { flex: 1; min-width: 0; }
.nd-buscar input, .nd-destinos select, .nd-destinos input {
  height: 32px; padding: 4px 8px; font: inherit; font-size: 13px;
  border: 1px solid var(--pt-borde-fuerte); border-radius: var(--pt-radio); background: #fff;
}
.nd-chips { display: flex; flex-wrap: wrap; gap: 6px; min-height: 32px; align-items: center; }
.nd-chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 4px 3px 10px; border-radius: 14px;
  background: #e8f0fe; color: #174ea6; font-size: 12px; font-weight: 600;
}
.nd-chip small { font-weight: 400; opacity: .8; }
.nd-chip--con { background: #fff4d6; color: #7a5600; }
.nd-chip button {
  border: 0; background: rgba(0,0,0,.08); color: inherit; cursor: pointer;
  width: 18px; height: 18px; border-radius: 50%; line-height: 1; padding: 0;
}
.nd-destinos { width: 100%; border-collapse: collapse; font-size: 13px; }
.nd-destinos th {
  text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .03em;
  color: var(--pt-texto-suave); padding: 0 6px 6px; border-bottom: 1px solid var(--pt-borde);
}
.nd-destinos td { padding: 4px 6px; border-bottom: 1px solid #eef1f4; vertical-align: middle; }
.nd-destinos tfoot td { border-bottom: 0; padding-top: 8px; }
.nd-destinos select { width: 100%; }
.nd-destinos .nd-pct { width: 96px; text-align: right; }
.nd-destinos .nd-pct input { width: 84px; text-align: right; }
.nd-destinos tr.nd-activo td { background: #f2f8ff; }
.nd-etiqueta { font-weight: 600; white-space: nowrap; }
.nd-quitar-destino {
  border: 0; background: transparent; color: var(--pt-rojo); font-size: 18px; cursor: pointer; line-height: 1;
}
.nd-suma {
  display: inline-block; min-width: 70px; padding: 4px 8px; border-radius: var(--pt-radio);
  background: var(--pt-cabecera); font-weight: 700; text-align: right; font-variant-numeric: tabular-nums;
}
.nd-suma--ok { background: #d9f2e3; color: #0f5132; }
.nd-suma--mal { background: #f8d7da; color: #842029; }
.nd-contador {
  padding: 1px 8px; border-radius: 10px; background: var(--pt-cabecera);
  font-size: 11px; color: var(--pt-texto-suave);
}
.nd-vigentes-envoltura { max-height: 260px; overflow: auto; }
.nd-vigentes { width: 100%; border-collapse: collapse; font-size: 13px; }
.nd-vigentes th {
  position: sticky; top: 0; background: var(--pt-fondo); text-align: left;
  font-size: 11px; text-transform: uppercase; color: var(--pt-texto-suave);
  padding: 6px 8px; border-bottom: 1px solid var(--pt-borde);
}
.nd-vigentes td { padding: 6px 8px; border-bottom: 1px solid #eef1f4; vertical-align: middle; }
.nd-reparto {
  display: inline-block; margin: 2px 6px 2px 0; padding: 2px 8px;
  border-radius: 12px; background: var(--pt-fondo-alt); border: 1px solid var(--pt-borde); font-size: 12px;
}
.nd-acciones { text-align: right; white-space: nowrap; }
.nd-acciones .pt-btn { padding: 3px 10px; font-size: 12px; }

/* ==========================================================================
   Diálogo "qué se actualiza con esta fila"
   ========================================================================== */
.pt-dialogo {
  padding: 0; border: 0; border-radius: 12px;
  width: min(520px, calc(100vw - 32px));
  box-shadow: 0 20px 50px rgba(16, 24, 40, .25);
  color: var(--pt-texto);
}
.pt-dialogo::backdrop { background: rgba(16, 24, 40, .45); }
.pt-dialogo__caja { display: flex; flex-direction: column; margin: 0; }
.pt-dialogo__cabecera { padding: 16px 20px 10px; border-bottom: 1px solid var(--pt-borde); }
.pt-dialogo__cabecera h3 { margin: 0 0 4px; font-size: 16px; }
.pt-dialogo__sub { margin: 0; font-size: 12.5px; color: var(--pt-texto-suave); }
.pt-dialogo__cuerpo { padding: 12px 20px; max-height: 60vh; overflow: auto; }
.pt-dialogo__pie {
  display: flex; justify-content: flex-end; gap: 8px;
  padding: 12px 20px; border-top: 1px solid var(--pt-borde); background: var(--pt-fondo-alt);
  border-radius: 0 0 12px 12px;
}
.da-atajos { display: flex; justify-content: flex-end; gap: 4px; margin-bottom: 4px; }
.da-lista { list-style: none; margin: 0; padding: 0; border: 1px solid var(--pt-borde); border-radius: 8px; }
.da-lista li + li { border-top: 1px solid var(--pt-borde); }
.da-lista label {
  display: grid; grid-template-columns: 18px 1fr; column-gap: 10px; row-gap: 1px;
  align-items: center; padding: 8px 12px; cursor: pointer;
}
.da-lista label:hover { background: var(--pt-fondo-alt); }
.da-lista input { width: 16px; height: 16px; margin: 0; grid-row: span 2; }
.da-nombre { font-weight: 600; font-size: 13.5px; }
.da-dep { grid-column: 2; font-size: 11.5px; color: var(--pt-texto-suave); }
.da-bloqueado label { cursor: not-allowed; opacity: .55; }
.da-nota { margin: 10px 0 0; font-size: 12px; color: var(--pt-texto-suave); }

.pt-acciones-fila button.pt-accion--aviso { background: #fff4d6; border-radius: 4px; box-shadow: inset 0 0 0 1px #f0c36d; }

/* ==========================================================================
   Selección de celdas tipo Excel
   ========================================================================== */
.pt-tabla td[data-col] { position: relative; }
.pt-tabla td.pt-celda--rango { background: rgba(26, 115, 232, .10); }
.pt-tabla td.pt-celda--relleno { background: rgba(26, 115, 232, .06); outline: 1px dashed var(--pt-azul); outline-offset: -1px; }
.pt-tabla td.pt-celda--cursor {
  outline: 2px solid var(--pt-azul);
  outline-offset: -2px;
  background: rgba(26, 115, 232, .06);
}
.pt-arrastre {
  position: absolute; right: -3px; bottom: -3px; width: 8px; height: 8px;
  background: var(--pt-azul); border: 1px solid #fff; border-radius: 1px;
  cursor: crosshair; z-index: 2;
}
.pt-tabla td.pt-celda--cursor .pt-entrada { outline: none; }
.pt-tabla { user-select: none; }
.pt-tabla .pt-entrada { user-select: text; }
.pt-ayuda-excel { color: var(--pt-texto-suave); font-size: 12px; }
.pt-ayuda-excel kbd {
  display: inline-block; padding: 0 4px; border: 1px solid var(--pt-borde-fuerte);
  border-bottom-width: 2px; border-radius: 4px; background: #fff; font-size: 11px; font-family: inherit;
}
