{% load static %}<!DOCTYPE html>
{% comment %}
  Tablero del presupuesto de nómina.
  - Parámetros: al guardarlos se recalcula TODO el presupuesto.
  - Resumen consolidado: cada concepto con su total, cuántas filas son
    manuales, de qué depende y a qué afecta. Cada fila es un enlace.
{% endcomment %}
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token }}">
  <title>Presupuesto Nómina</title>
  <link rel="stylesheet" href="{% static 'css/presupuesto_tabla.css' %}">
  <style>
    .dash-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
    .dash-campo { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .dash-campo label { font-size: 13px; font-weight: 600; }
    .dash-campo input { width: 130px; padding: 6px 8px; border: 1px solid var(--pt-borde-fuerte); border-radius: var(--pt-radio); font: inherit; }
    .dash-seccion { margin-top: 16px; }
    .dash-seccion h3 { margin-bottom: 8px; }
    .dash-alta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .dash-alta input, .dash-alta select { padding: 6px 8px; min-width: 230px; border: 1px solid var(--pt-borde-fuerte); border-radius: var(--pt-radio); font: inherit; text-transform: uppercase; }

    table.resumen { width: 100%; border-collapse: collapse; font-size: 13px; }
    table.resumen th, table.resumen td { padding: 7px 10px; border-bottom: 1px solid var(--pt-borde); text-align: left; vertical-align: top; }
    table.resumen thead th { background: var(--pt-cabecera); font-weight: 600; }
    table.resumen tbody tr.grupo th { background: var(--pt-fondo-alt); font-size: 12px; color: var(--pt-texto-suave); }
    table.resumen td.num, table.resumen th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    table.resumen tfoot th { border-top: 2px solid var(--pt-borde-fuerte); background: #eaf1e9; }
    table.resumen a { color: var(--pt-azul); font-weight: 600; text-decoration: none; }
    table.resumen a:hover { text-decoration: underline; }
    .dep { color: var(--pt-texto-suave); font-size: 12px; }
    .origen-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px 14px; align-items: end; }
    .origen-form label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; font-weight: 600; }
    .origen-form input, .origen-form select { padding: 6px 8px; border: 1px solid var(--pt-borde-fuerte); border-radius: var(--pt-radio); font: inherit; font-weight: 400; }
    .origen-form .check { flex-direction: row; align-items: center; font-weight: 400; }
    .origen-form .ayuda { font-weight: 400; font-size: 11px; color: var(--pt-texto-suave); }
    .origen-acciones { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
    .origen-estado { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 4px 0 12px; font-size: 13px; }
    .origen-estado strong { font-variant-numeric: tabular-nums; }
    .etiqueta-uso { display: inline-block; padding: 1px 7px; margin: 1px 2px; border-radius: 10px; background: #e3eefc; color: #1d4f91; font-size: 11px; white-space: nowrap; }
    .origen-sub { margin: 16px 0 8px; font-size: 14px; }
    .vacio { color: #a0a8b1; }
  </style>
</head>
<body>

  <h2>Presupuesto de nómina</h2>

  <div class="pt-barra">
    <a class="pt-btn" href="{% url 'nomina_tabla' 'todos' %}">🗂️ Ver todo consolidado</a>
    <a class="pt-btn pt-btn--exito" href="{% url 'exportar_excel' %}">📊 Exportar a Excel</a>
    <a class="pt-btn pt-btn--primario" href="{% url 'exportar_nomina_vertical' %}">📊 Exportar a Excel vertical</a>
    <span class="pt-espaciador"></span>
    <button type="button" class="pt-btn" id="btnRecargarBases" data-url="{% url 'nomina_recargar_bases' %}"
            title="Vuelve a leer todos los conceptos base desde los datos de origen">📥 Recargar desde Conceptos</button>
    <button type="button" class="pt-btn" id="btnRecalcular" data-url="{% url 'nomina_recalcular_todo' %}">🔄 Recalcular todo</button>
    <button type="button" class="pt-btn pt-btn--exito" id="btnActualizar">Guardar parámetros y recalcular</button>
  </div>

  <div class="pt-panel">
    <h3>Datos de origen (conceptos fijos y variables)</h3>
    <div class="origen-estado">
      <span>Año base: <strong>{{ origen.anio_base }}</strong>{% if not origen.config_anio %} <span class="dep">(automático)</span>{% endif %}</span>
      <span>Auxilio de educación usa: <strong>{{ origen.anio_educacion }}</strong></span>
      <span>Meses reales: <strong>{{ origen.meses_reales }}</strong> (enero a {{ origen.mes_reales_nombre }}){% if not origen.config_meses %} <span class="dep">(automático)</span>{% endif %}</span>
    </div>

    <div class="pt-tabla-envoltura" style="max-height:none">
      <table class="resumen">
        <thead>
          <tr>
            <th>Año</th><th class="num">Filas</th><th class="num">Personas</th>
            <th>Datos hasta</th><th>Fecha de corte</th><th>Se usa para</th>
            <th>Última carga</th><th></th>
          </tr>
        </thead>
        <tbody>
          {% for a in origen.anios %}
            <tr>
              <td><strong>{{ a.anio }}</strong></td>
              <td class="num">{{ a.filas }}</td>
              <td class="num">{{ a.personas }}</td>
              <td>{{ a.hasta }} <span class="dep">({{ a.meses }} meses)</span></td>
              <td>{{ a.corte|date:"d/m/Y"|default:"—" }}</td>
              <td>{% for u in a.usos %}<span class="etiqueta-uso">{{ u }}</span>{% empty %}<span class="vacio">—</span>{% endfor %}</td>
              <td class="dep">{{ a.cargado|date:"d/m/Y H:i" }}</td>
              <td style="white-space:nowrap">
                <a href="{% url 'nomina_origen_exportar' a.anio %}" title="Descargar">📥</a>
                <button type="button" class="pt-btn pt-btn--peligro" data-borrar-anio="{{ a.anio }}" title="Borrar los datos de este año">🗑️</button>
              </td>
            </tr>
          {% empty %}
            <tr><td colspan="8" class="vacio">Todavía no hay datos cargados. Suba el Excel de conceptos.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <h4 class="origen-sub">Subir Excel de conceptos</h4>
    <form id="formOrigen" class="origen-form" action="{% url 'nomina_origen_subir' %}" enctype="multipart/form-data">
      <label>Archivo (.xlsx, .xls, .csv)
        <input type="file" name="archivo" accept=".xlsx,.xlsm,.xls,.csv" required>
      </label>
      <label>Año de los datos
        <input type="number" name="anio" min="2000" max="2100" value="{{ origen.anio_sugerido }}" required>
        <span class="ayuda">Si el archivo trae una columna AÑO o FECHA, se usa esa en las filas que la tengan.</span>
      </label>
      <label>Fecha de corte (opcional)
        <input type="date" name="fecha_corte">
        <span class="ayuda">Hasta dónde llegan los datos reales. Si la deja vacía se toma el último mes con valores.</span>
      </label>
      <label>Hoja (opcional)
        <input type="text" name="hoja" placeholder="Primera hoja">
      </label>
      <label>Si ya hay datos de ese año
        <select name="modo">
          <option value="reemplazar" selected>Reemplazarlos</option>
          <option value="agregar">Agregar a los existentes</option>
        </select>
      </label>
      <label class="check">
        <input type="checkbox" name="recargar" value="1">
        Recargar el presupuesto con estos datos
      </label>
    </form>
    <div class="origen-acciones">
      <button type="button" class="pt-btn pt-btn--exito" id="btnSubirOrigen">⬆️ Subir archivo</button>
      <a class="pt-btn" href="{% url 'nomina_origen_plantilla' %}">📄 Descargar plantilla</a>
    </div>

    <h4 class="origen-sub">Qué datos usar</h4>
    <form id="formConfigOrigen" class="origen-form" action="{% url 'nomina_origen_config' %}">
      <label>Año base
        <select name="anio_base">
          <option value="">Automático (el más reciente)</option>
          {% for a in origen.anios %}
            <option value="{{ a.anio }}" {% if origen.config_anio == a.anio %}selected{% endif %}>{{ a.anio }}</option>
          {% endfor %}
        </select>
        <span class="ayuda">El auxilio de educación toma siempre el año anterior al base.</span>
      </label>
      <label>Meses con datos reales
        <select name="meses_reales">
          <option value="">Automático (último mes con datos)</option>
          {% for n, nombre in origen.meses %}
            <option value="{{ n }}" {% if origen.config_meses == n %}selected{% endif %}>Enero a {{ nombre }} ({{ n }})</option>
          {% endfor %}
        </select>
        <span class="ayuda">Esos meses se incrementan; los siguientes se proyectan con el promedio.</span>
      </label>
      <label class="check">
        <input type="checkbox" name="recargar" value="1" checked>
        Recargar el presupuesto al guardar
      </label>
    </form>
    <div class="origen-acciones">
      <button type="button" class="pt-btn pt-btn--primario" id="btnConfigOrigen">Guardar selección</button>
    </div>
    <p class="dep" style="margin-top:10px">⚠️ Recargar reemplaza las filas de los conceptos base (sueldos, comisiones, horas extra…), incluidas las editadas a mano. Los ajustes manuales de los conceptos calculados se conservan.</p>
  </div>

  <div class="pt-panel dash-seccion">
    <h3>Parámetros del presupuesto</h3>
    <p>Al guardarlos se recalculan todas las filas calculadas de todos los conceptos. Las filas manuales no se tocan.</p>
    <div class="dash-grid">
      <div class="dash-campo"><label for="incrementoSalarial">Incremento salarial (%)</label>
        <input type="number" id="incrementoSalarial" name="incrementoSalarial" min="0" step="0.01" value="{{ parametros.incremento_salarial|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="incrementoIPC">Incremento IPC (%)</label>
        <input type="number" id="incrementoIPC" name="incrementoIPC" min="0" step="0.01" value="{{ parametros.incremento_ipc|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="incrementoComisiones">Incremento comisiones (%)</label>
        <input type="number" id="incrementoComisiones" name="incrementoComisiones" min="0" step="0.01" value="{{ parametros.incremento_comisiones|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="auxilioTransporte">Auxilio de transporte (%)</label>
        <input type="number" id="auxilioTransporte" name="auxilioTransporte" min="0" step="0.01" value="{{ parametros.auxilio_transporte|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="cesantias">Cesantías (%)</label>
        <input type="number" id="cesantias" name="cesantias" min="0" step="0.01" value="{{ parametros.cesantias|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="interesesCesantias">Intereses cesantías (%)</label>
        <input type="number" id="interesesCesantias" name="interesesCesantias" min="0" step="0.01" value="{{ parametros.intereses_cesantias|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="prima">Prima (%)</label>
        <input type="number" id="prima" name="prima" min="0" step="0.01" value="{{ parametros.prima|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="vacaciones">Vacaciones (%)</label>
        <input type="number" id="vacaciones" name="vacaciones" min="0" step="0.01" value="{{ parametros.vacaciones|default_if_none:''|cut:',' }}"></div>
      <div class="dash-campo"><label for="salarioMinimo">Salario mínimo</label>
        <input type="number" id="salarioMinimo" name="salarioMinimo" min="0" step="0.01" value="{{ parametros.salario_minimo|default_if_none:''|cut:',' }}"></div>
    </div>
  </div>

  <div class="pt-panel dash-seccion">
    <h3>Resumen consolidado</h3>
    <div class="pt-tabla-envoltura" style="max-height:none">
      <table class="resumen">
        <thead>
          <tr>
            <th>Concepto</th>
            <th class="num">Filas</th>
            <th class="num">Manuales</th>
            <th class="num">Total anual</th>
            <th>Se calcula a partir de</th>
            <th>Si cambia, actualiza</th>
          </tr>
        </thead>
        <tbody>
          {% for grupo in grupos %}
            <tr class="grupo"><th colspan="6">{{ grupo.nombre }}</th></tr>
            {% for c in grupo.conceptos %}
              <tr>
                <td>
                  <a href="{% url 'nomina_tabla' c.slug %}">{{ c.etiqueta }}</a>
                  {% if c.derivado %}<span class="pt-origen pt-origen--sistema" title="Se calcula a partir de otros conceptos">⚙️</span>{% endif %}
                </td>
                <td class="num">{{ c.filas }}</td>
                <td class="num">{% if c.manuales %}<span class="pt-origen pt-origen--manual">✋ {{ c.manuales }}</span>{% else %}<span class="vacio">0</span>{% endif %}</td>
                <td class="num">{% if c.total %}{{ c.total_fmt }}{% else %}<span class="vacio">0</span>{% endif %}</td>
                <td class="dep">{{ c.depende|join:", "|default:"Datos de origen" }}</td>
                <td class="dep">{{ c.afecta|join:", "|default:"—" }}</td>
              </tr>
            {% endfor %}
          {% endfor %}
        </tbody>
        <tfoot>
          <tr>
            <th>Total nómina</th><th></th><th></th>
            <th class="num">{{ total_general }}</th>
            <th></th><th></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <div class="pt-panel dash-seccion">
    <h3>Agregar cargo o NOMCOSTO</h3>
    <div class="dash-alta" style="margin-bottom:10px">
      <input type="text" id="nuevoCargo" placeholder="Nombre del cargo">
      <button type="button" class="pt-btn pt-btn--primario"
              data-alta="insertar_concepto" data-campo="nombrecar"
              data-entrada="nuevoCargo" data-lista="listaCargos">Agregar cargo</button>
      <select id="listaCargos">
        {% for nombre in nombres_cargos %}<option value="{{ nombre }}">{{ nombre }}</option>
        {% empty %}<option disabled>No hay cargos registrados</option>{% endfor %}
      </select>
    </div>
    <div class="dash-alta">
      <input type="text" id="nuevoNomcosto" placeholder="Nombre del costo">
      <button type="button" class="pt-btn pt-btn--primario"
              data-alta="insertar_nomcosto" data-campo="nomcosto"
              data-entrada="nuevoNomcosto" data-lista="listaNomcosto">Agregar NOMCOSTO</button>
      <select id="listaNomcosto">
        {% for nombre in nombres_costos %}<option value="{{ nombre }}">{{ nombre }}</option>
        {% empty %}<option disabled>No hay NOMCOSTOS registrados</option>{% endfor %}
      </select>
    </div>
  </div>

  <script src="{% static 'js/presupuesto_tabla.js' %}"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const token = document.querySelector('meta[name="csrf-token"]').content;

      const enviar = (datos) => fetch('', {
        method: 'POST',
        body: datos,
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRFToken': token }
      }).then(r => r.json());

      document.querySelectorAll('.dash-alta input').forEach(input => {
        input.addEventListener('input', () => { input.value = input.value.toUpperCase(); });
      });

      document.querySelectorAll('[data-alta]').forEach(boton => {
        boton.addEventListener('click', () => PT.conSpinner(boton, async () => {
          const entrada = document.getElementById(boton.dataset.entrada);
          const valor = entrada.value.trim();
          if (!valor) { PT.toast('Escribe un nombre antes de agregar ⚠️', 'warning'); return; }

          const datos = new FormData();
          datos.append('action', boton.dataset.alta);
          datos.append(boton.dataset.campo, valor);

          try {
            const r = await enviar(datos);
            PT.toast(r.msg, r.status === 'ok' ? 'success' : 'error');
            if (r.status === 'ok') {
              document.getElementById(boton.dataset.lista).appendChild(new Option(valor, valor));
              entrada.value = '';
            }
          } catch (e) { PT.toast('Error al guardar ❌', 'error'); }
        }));
      });

      const recargar = () => setTimeout(() => window.location.reload(), 900);

      const btnActualizar = document.getElementById('btnActualizar');
      btnActualizar.addEventListener('click', () => PT.conSpinner(btnActualizar, async () => {
        const datos = new FormData();
        document.querySelectorAll('.dash-campo input[name]').forEach(i => datos.append(i.name, i.value));
        try {
          const r = await enviar(datos);
          PT.toast(r.msg || 'Parámetros actualizados ✅', r.status === 'error' ? 'error' : 'success');
          if (r.status !== 'error') recargar();
        } catch (e) { PT.toast('Error al guardar ❌', 'error'); }
      }));

      const avisoRecarga = '¿Recargar los conceptos base? Se reemplazan sus filas, incluidas las editadas a mano.';

      const enviarForm = (boton, form, extra) => PT.conSpinner(boton, async () => {
        const datos = new FormData(form);
        try {
          const r = await PT.pedir(form.getAttribute('action'), { method: 'POST', body: datos });
          PT.toast(r.msg || 'Listo ✅', 'success', 9000);
          if (extra) extra(r);
          setTimeout(() => window.location.reload(), 2500);
        } catch (e) { PT.toast('❌ ' + e.message, 'error', 9000); }
      });

      const formOrigen = document.getElementById('formOrigen');
      const btnSubirOrigen = document.getElementById('btnSubirOrigen');
      btnSubirOrigen.addEventListener('click', () => {
        if (!formOrigen.archivo.files.length) { PT.toast('Seleccione el archivo ⚠️', 'warning'); return; }
        if (!formOrigen.anio.value && !formOrigen.fecha_corte.value) { PT.toast('Indique el año de los datos ⚠️', 'warning'); return; }
        if (formOrigen.fecha_corte.value && formOrigen.anio.value &&
            formOrigen.fecha_corte.value.slice(0, 4) !== formOrigen.anio.value) {
          PT.toast('La fecha de corte no es del año indicado ⚠️', 'warning'); return;
        }
        if (formOrigen.recargar.checked && !confirm(avisoRecarga)) return;
        enviarForm(btnSubirOrigen, formOrigen);
      });

      const formConfig = document.getElementById('formConfigOrigen');
      const btnConfig = document.getElementById('btnConfigOrigen');
      btnConfig.addEventListener('click', () => {
        if (formConfig.recargar.checked && !confirm(avisoRecarga)) return;
        enviarForm(btnConfig, formConfig);
      });

      document.querySelectorAll('[data-borrar-anio]').forEach(boton => {
        boton.addEventListener('click', () => {
          const anio = boton.dataset.borrarAnio;
          if (!confirm(`¿Borrar todos los datos de origen del ${anio}? El presupuesto ya calculado no cambia hasta que se recargue.`)) return;
          const datos = new FormData();
          datos.append('anio', anio);
          PT.conSpinner(boton, async () => {
            try {
              const r = await PT.pedir("{% url 'nomina_origen_borrar' %}", { method: 'POST', body: datos });
              PT.toast(r.msg); recargar();
            } catch (e) { PT.toast('❌ ' + e.message, 'error'); }
          });
        });
      });

      const btnRecargarBases = document.getElementById('btnRecargarBases');
      btnRecargarBases.addEventListener('click', () => {
        if (!confirm(avisoRecarga)) return;
        PT.conSpinner(btnRecargarBases, async () => {
          try {
            const r = await PT.pedir(btnRecargarBases.dataset.url, { method: 'POST' });
            PT.toast(r.msg, 'success', 6000); recargar();
          } catch (e) { PT.toast('❌ ' + e.message, 'error'); }
        });
      });

      const btnRecalcular = document.getElementById('btnRecalcular');
      btnRecalcular.addEventListener('click', () => PT.conSpinner(btnRecalcular, async () => {
        try {
          const r = await PT.pedir(btnRecalcular.dataset.url, { method: 'POST' });
          PT.toast(r.msg || 'Recalculado ✅');
          recargar();
        } catch (e) { PT.toast('Error al recalcular ❌ ' + e.message, 'error'); }
      }));
    });
  </script>
</body>
</html>
